<?xml version="1.0" encoding="utf-8"?>
<!--
  Spawn Stations UI model.
  The hub signals Draw. This file writes md.$cm90.$stui and refreshes once.
  The station queue is md.$cm90_session.$station. Closing the window does not clear it.
  It does not create widgets. Build hands the picked lists to the logic file.
-->
<mdscript name="cm90_station_ui_model" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
	<cues>
		<cue name="Ensure_Ui" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<do_if value="not md.$cm90?">
					<set_value name="md.$cm90" exact="table[]"/>
				</do_if>
				<do_if value="not md.$cm90.$stui?">
					<set_value name="md.$cm90.$stui" exact="table[]"/>
					<set_value name="md.$cm90.$stui.$view" exact="'races'"/>
					<set_value name="md.$cm90.$stui.$paint" exact="'races'"/>
					<set_value name="md.$cm90.$stui.$race" exact="''"/>
					<set_value name="md.$cm90.$stui.$type" exact="''"/>
					<set_value name="md.$cm90.$stui.$off" exact="0"/>
					<set_value name="md.$cm90.$stui.$pk_id" exact="[]"/>
					<set_value name="md.$cm90.$stui.$pk_n" exact="[]"/>
					<set_value name="md.$cm90.$stui.$pk_obj" exact="[]"/>
					<set_value name="md.$cm90.$stui.$racebtns" exact="[]"/>
					<set_value name="md.$cm90.$stui.$lines" exact="[]"/>
					<set_value name="md.$cm90.$stui.$showprev" exact="0"/>
					<set_value name="md.$cm90.$stui.$shownext" exact="0"/>
					<set_value name="md.$cm90.$stui.$nomods" exact="0"/>
					<set_value name="md.$cm90.$stui.$status" exact="''"/>
				</do_if>
				<do_if value="not md.$cm90.$stui.$status?">
					<set_value name="md.$cm90.$stui.$status" exact="''"/>
				</do_if>
			</actions>
		</cue>

		<cue name="On_Menu_Closed" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Menu'" control="'closed'"/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$status_reset" exact="1"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status reset armed reason=' + event.param3"/>
			</actions>
		</cue>

		<cue name="Draw" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<do_if value="@md.$cm90.$stui.$status_reset">
					<set_value name="md.$cm90.$stui.$status" exact="''"/>
					<set_value name="md.$cm90.$stui.$status_paint" exact="0"/>
					<set_value name="md.$cm90.$stui.$status_reset" exact="0"/>
					<remove_value name="md.$cm90.$stui.$status_t"/>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status reset on open'"/>
				</do_if>
				<do_elseif value="@md.$cm90.$stui.$status">
					<set_value name="$stale" exact="0"/>
					<do_if value="not md.$cm90.$stui.$status_t?">
						<set_value name="$stale" exact="1"/>
					</do_if>
					<do_elseif value="player.age gt (md.$cm90.$stui.$status_t + 1)">
						<set_value name="$stale" exact="1"/>
					</do_elseif>
					<do_if value="$stale">
						<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status reset stale t=' + player.age + ' was=' + @md.$cm90.$stui.$status_t"/>
						<set_value name="md.$cm90.$stui.$status" exact="''"/>
						<set_value name="md.$cm90.$stui.$status_paint" exact="0"/>
						<remove_value name="md.$cm90.$stui.$status_t"/>
					</do_if>
				</do_elseif>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station state view=' + md.$cm90.$stui.$view + ' race=' + md.$cm90.$stui.$race + ' type=' + md.$cm90.$stui.$type + ' off=' + md.$cm90.$stui.$off + ' picks=' + @md.$cm90.$stui.$pk_id.count + ' ready=' + @md.$cm90.$stready"/>
				<signal_cue_instantly cue="md.cm90_station_logic.Ensure_Catalog"/>
				<do_if value="not @md.$cm90.$stready">
					<set_value name="md.$cm90.$stui.$paint" exact="'loading'"/>
					<do_if value="not @md.$cm90.$stwait">
						<set_value name="md.$cm90.$stwait" exact="true"/>
						<set_value name="md.$cm90.$stwaitn" exact="0"/>
						<signal_cue_instantly cue="Catalog_Wait"/>
					</do_if>
				</do_if>
				<do_elseif value="md.$cm90.$stui.$view == 'build'">
					<signal_cue_instantly cue="Compose_Build"/>
					<signal_cue_instantly cue="Compose_Owners"/>
					<set_value name="md.$cm90.$stui.$paint" exact="'build'"/>
				</do_elseif>
				<do_else>
					<signal_cue_instantly cue="Compose_Races"/>
					<set_value name="md.$cm90.$stui.$paint" exact="'races'"/>
				</do_else>
				<signal_cue_instantly cue="md.cm90_station_ui.Paint"/>
			</actions>
		</cue>

		<cue name="On_Catalog" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station model catalog rows=' + @md.$cm90.$strows.count + ' races=' + @md.$cm90.$straces.count"/>
				<do_if value="@md.$cm90.$pane == 'station' and @md.$cm90.$stui.$paint == 'loading'">
					<set_value name="md.$cm90.$stwait" exact="false"/>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station catalog ready refresh'"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
				</do_if>
			</actions>
		</cue>

		<cue name="Catalog_Wait" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<set_value name="md.$cm90.$stwaitn" exact="@md.$cm90.$stwaitn + 1"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station catalog wait n=' + md.$cm90.$stwaitn"/>
			</actions>
			<cues>
				<cue name="Catalog_Wait_Fire">
					<actions>
						<set_value name="$hold" exact="1"/>
					</actions>
					<delay exact="1s"/>
					<actions>
						<set_value name="$pane" exact="@md.$cm90.$pane"/>
						<do_if value="$pane != 'station'">
							<set_value name="md.$cm90.$stwait" exact="false"/>
							<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station catalog wait stop pane=' + $pane"/>
						</do_if>
						<do_elseif value="@md.$cm90.$stready">
							<set_value name="md.$cm90.$stwait" exact="false"/>
							<do_if value="@md.$cm90.$pane == 'station' and @md.$cm90.$stui.$paint == 'loading'">
								<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station catalog refresh'"/>
								<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
							</do_if>
							<do_else>
								<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station catalog wait drop paint=' + @md.$cm90.$stui.$paint"/>
							</do_else>
						</do_elseif>
						<do_elseif value="md.$cm90.$stwaitn ge 10">
							<set_value name="md.$cm90.$stwait" exact="false"/>
							<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station pick timeout'"/>
						</do_elseif>
						<do_else>
							<signal_cue_instantly cue="Catalog_Wait"/>
						</do_else>
					</actions>
				</cue>
			</cues>
		</cue>

		<cue name="Compose_Races" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<set_value name="md.$cm90.$stui.$racebtns" exact="[]"/>
				<do_all exact="@md.$cm90.$straces.count" counter="$i">
					<set_value name="$b" exact="md.$cm90.$straces.{$i}"/>
					<append_to_list name="md.$cm90.$stui.$racebtns" exact="table[
							$id = $b.$id,
							$text = $b.$label + ' (' + $b.$n + ')'
						]"/>
				</do_all>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station races n=' + @md.$cm90.$stui.$racebtns.count"/>
			</actions>
		</cue>

		<cue name="Compose_Build" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<set_value name="$pagesize" exact="15"/>
				<do_if value="not md.$cm90.$stui.$off?">
					<set_value name="md.$cm90.$stui.$off" exact="0"/>
				</do_if>
				<set_value name="$raw" exact="[]"/>
				<set_value name="$types" exact="[]"/>
				<set_value name="$pref" exact="[]"/>
				<append_to_list name="$pref" exact="'dock'"/>
				<append_to_list name="$pref" exact="'storage'"/>
				<append_to_list name="$pref" exact="'production'"/>
				<append_to_list name="$pref" exact="'habitation'"/>
				<append_to_list name="$pref" exact="'welfare'"/>
				<append_to_list name="$pref" exact="'defence'"/>
				<append_to_list name="$pref" exact="'build'"/>
				<append_to_list name="$pref" exact="'processing'"/>
				<append_to_list name="$pref" exact="'radar'"/>
				<append_to_list name="$pref" exact="'venture'"/>
				<append_to_list name="$pref" exact="'other'"/>
				<do_all exact="@md.$cm90.$strows.count" counter="$i">
					<set_value name="$row" exact="md.$cm90.$strows.{$i}"/>
					<do_if value="$row.$race == md.$cm90.$stui.$race and $row.$conn != '1'">
						<set_value name="$slot" exact="$raw.indexof.{$row.$lib}"/>
						<do_if value="not $slot">
							<append_to_list name="$raw" exact="$row.$lib"/>
						</do_if>
					</do_if>
				</do_all>
				<do_all exact="$pref.count" counter="$p">
					<set_value name="$want" exact="$pref.{$p}"/>
					<set_value name="$slot" exact="$raw.indexof.{$want}"/>
					<do_if value="$slot">
						<append_to_list name="$types" exact="$want"/>
					</do_if>
				</do_all>
				<set_value name="$rest" exact="[]"/>
				<do_all exact="$raw.count" counter="$i">
					<set_value name="$slot" exact="$types.indexof.{$raw.{$i}}"/>
					<do_if value="not $slot">
						<append_to_list name="$rest" exact="$raw.{$i}"/>
					</do_if>
				</do_all>
				<do_if value="$rest.count gt 1">
					<sort_list list="$rest" sortbyvalue="loop.element"/>
				</do_if>
				<do_all exact="$rest.count" counter="$i">
					<append_to_list name="$types" exact="$rest.{$i}"/>
				</do_all>
				<set_value name="$midx" exact="[]"/>
				<set_value name="$mseen" exact="[]"/>
				<do_if value="md.$cm90.$stui.$type? and md.$cm90.$stui.$type != ''">
					<do_all exact="@md.$cm90.$strows.count" counter="$i">
						<set_value name="$row" exact="md.$cm90.$strows.{$i}"/>
						<do_if value="$row.$race == md.$cm90.$stui.$race and $row.$lib == md.$cm90.$stui.$type and $row.$conn != '1'">
							<set_value name="$slot" exact="$mseen.indexof.{$row.$macro}"/>
							<do_if value="not $slot">
								<append_to_list name="$mseen" exact="$row.$macro"/>
								<append_to_list name="$midx" exact="$i"/>
							</do_if>
						</do_if>
					</do_all>
				</do_if>
				<do_if value="md.$cm90.$stui.$off lt 0 or (@$midx.count and md.$cm90.$stui.$off ge $midx.count)">
					<set_value name="md.$cm90.$stui.$off" exact="0"/>
				</do_if>
				<set_value name="$shown" exact="0"/>
				<do_if value="@$midx.count gt md.$cm90.$stui.$off">
					<set_value name="$shown" exact="$midx.count - md.$cm90.$stui.$off"/>
					<do_if value="$shown gt $pagesize">
						<set_value name="$shown" exact="$pagesize"/>
					</do_if>
				</do_if>
				<set_value name="$nrows" exact="$types.count"/>
				<do_if value="$shown gt $nrows">
					<set_value name="$nrows" exact="$shown"/>
				</do_if>
				<do_if value="$nrows gt $pagesize">
					<set_value name="$nrows" exact="$pagesize"/>
				</do_if>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station board race=' + @md.$cm90.$stui.$race + ' type=' + @md.$cm90.$stui.$type + ' types=' + $types.count + ' mods=' + @$midx.count + ' off=' + md.$cm90.$stui.$off"/>
				<do_if value="$types.count gt $pagesize">
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station types truncated n=' + $types.count"/>
				</do_if>
				<set_value name="md.$cm90.$stui.$lines" exact="[]"/>
				<set_value name="md.$cm90.$stui.$nomods" exact="0"/>
				<do_if value="$nrows gt 0">
					<do_all exact="$nrows" counter="$r">
						<set_value name="$has_type" exact="0"/>
						<set_value name="$t_id" exact="''"/>
						<set_value name="$t_text" exact="''"/>
						<set_value name="$t_on" exact="0"/>
						<set_value name="$has_mod" exact="0"/>
						<set_value name="$m_name" exact="''"/>
						<set_value name="$m_macro" exact="''"/>
						<set_value name="$m_qty" exact="0"/>
						<set_value name="$m_row" exact="0"/>
						<do_if value="$r le $types.count and $r le $pagesize">
							<set_value name="$lib" exact="$types.{$r}"/>
							<set_value name="$has_type" exact="1"/>
							<set_value name="$t_id" exact="$lib"/>
							<set_value name="$t_text" exact="$lib"/>
							<do_if value="$lib == 'dock'"><set_value name="$t_text" exact="{357424,30}"/></do_if>
							<do_elseif value="$lib == 'storage'"><set_value name="$t_text" exact="{357424,31}"/></do_elseif>
							<do_elseif value="$lib == 'production'"><set_value name="$t_text" exact="{357424,32}"/></do_elseif>
							<do_elseif value="$lib == 'habitation'"><set_value name="$t_text" exact="{357424,33}"/></do_elseif>
							<do_elseif value="$lib == 'welfare'"><set_value name="$t_text" exact="{357424,34}"/></do_elseif>
							<do_elseif value="$lib == 'defence'"><set_value name="$t_text" exact="{357424,35}"/></do_elseif>
							<do_elseif value="$lib == 'build'"><set_value name="$t_text" exact="{357424,36}"/></do_elseif>
							<do_elseif value="$lib == 'processing'"><set_value name="$t_text" exact="{357424,37}"/></do_elseif>
							<do_elseif value="$lib == 'radar'"><set_value name="$t_text" exact="{357424,38}"/></do_elseif>
							<do_elseif value="$lib == 'venture'"><set_value name="$t_text" exact="{357424,39}"/></do_elseif>
							<do_elseif value="$lib == 'other'"><set_value name="$t_text" exact="{357424,40}"/></do_elseif>
							<do_if value="$lib == md.$cm90.$stui.$type">
								<set_value name="$t_on" exact="1"/>
							</do_if>
						</do_if>
						<set_value name="$pos" exact="md.$cm90.$stui.$off + $r"/>
						<do_if value="$pos le @$midx.count and $pos ge 1">
							<set_value name="$i" exact="$midx.{$pos}"/>
							<set_value name="$mod" exact="md.$cm90.$strows.{$i}"/>
							<set_value name="$qty" exact="0"/>
							<set_value name="$pslot" exact="md.$cm90.$stui.$pk_id.indexof.{$mod.$macro}"/>
							<do_if value="$pslot">
								<set_value name="$qty" exact="md.$cm90.$stui.$pk_n.{$pslot}"/>
							</do_if>
							<set_value name="$has_mod" exact="1"/>
							<set_value name="$m_name" exact="$mod.$name"/>
							<set_value name="$m_macro" exact="$mod.$macro"/>
							<set_value name="$m_qty" exact="$qty"/>
							<set_value name="$m_row" exact="$i"/>
							<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station cell macro=' + $mod.$macro + ' stored=' + $qty"/>
						</do_if>
						<append_to_list name="md.$cm90.$stui.$lines" exact="table[
								$has_type = $has_type,
								$t_id = $t_id,
								$t_text = $t_text,
								$t_on = $t_on,
								$has_mod = $has_mod,
								$m_name = $m_name,
								$m_macro = $m_macro,
								$m_qty = $m_qty,
								$m_row = $m_row
							]"/>
					</do_all>
				</do_if>
				<do_elseif value="md.$cm90.$stui.$type? and md.$cm90.$stui.$type != ''">
					<set_value name="md.$cm90.$stui.$nomods" exact="1"/>
				</do_elseif>
				<set_value name="md.$cm90.$stui.$showprev" exact="0"/>
				<set_value name="md.$cm90.$stui.$shownext" exact="0"/>
				<do_if value="@$midx.count gt $pagesize">
					<do_if value="md.$cm90.$stui.$off gt 0">
						<set_value name="md.$cm90.$stui.$showprev" exact="1"/>
					</do_if>
					<do_if value="md.$cm90.$stui.$off + $pagesize lt $midx.count">
						<set_value name="md.$cm90.$stui.$shownext" exact="1"/>
					</do_if>
				</do_if>
			</actions>
		</cue>

		<cue name="On_Race" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$race" exact="event.param.$echo"/>
				<set_value name="md.$cm90.$stui.$type" exact="''"/>
				<set_value name="md.$cm90.$stui.$off" exact="0"/>
				<set_value name="md.$cm90.$stui.$view" exact="'build'"/>
				<set_value name="md.$cm90.$stui.$pk_id" exact="[]"/>
				<set_value name="md.$cm90.$stui.$pk_n" exact="[]"/>
				<set_value name="md.$cm90.$stui.$pk_obj" exact="[]"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station race=' + @md.$cm90.$stui.$race"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="On_Back" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$view" exact="'races'"/>
				<set_value name="md.$cm90.$stui.$type" exact="''"/>
				<set_value name="md.$cm90.$stui.$off" exact="0"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station back'"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="On_Type" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$type" exact="event.param.$echo"/>
				<set_value name="md.$cm90.$stui.$off" exact="0"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station type=' + @md.$cm90.$stui.$type"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="On_Mod_Next" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$off" exact="@md.$cm90.$stui.$off + 15"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="On_Mod_Prev" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$off" exact="@md.$cm90.$stui.$off - 15"/>
				<do_if value="md.$cm90.$stui.$off lt 0">
					<set_value name="md.$cm90.$stui.$off" exact="0"/>
				</do_if>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="Compose_Owners" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<set_value name="md.$cm90.$stui.$owners" exact="[]"/>
				<set_value name="$seen" exact="[]"/>
				<set_value name="$kept_criminal" exact="0"/>
				<set_value name="$skip_visitor" exact="0"/>
				<set_value name="$skip_service" exact="0"/>
				<set_value name="$skip_criminal" exact="0"/>
				<set_value name="$skip_idle" exact="0"/>
				<set_value name="$skip_dup" exact="0"/>
				<set_value name="$service" exact="['civilian', 'ownerless', 'smuggler', 'outlaw', 'holyorderfanatic']"/>
				<set_value name="$vname" exact="@faction.visitor.knownname"/>
				<do_for_each name="$f" in="lookup.faction.list">
					<set_value name="$label" exact="@$f.knownname"/>
					<do_if value="not $label">
						<set_value name="$label" exact="@$f.name"/>
					</do_if>
					<do_if value="not $label">
						<set_value name="$label" exact="$f.id"/>
					</do_if>
					<set_value name="$is_visitor" exact="0"/>
					<do_if value="$f.id == 'visitor' or $f.hastag.visitor or $label == 'Visitor' or $label == 'visitor'">
						<set_value name="$is_visitor" exact="1"/>
					</do_if>
					<do_elseif value="$vname and $label == $vname">
						<set_value name="$is_visitor" exact="1"/>
					</do_elseif>
					<set_value name="$is_criminal" exact="0"/>
					<do_if value="$f.id == 'criminal'">
						<set_value name="$is_criminal" exact="1"/>
					</do_if>
					<do_if value="$is_visitor">
						<set_value name="$skip_visitor" exact="$skip_visitor + 1"/>
					</do_if>
					<do_elseif value="$service.indexof.{$f.id}">
						<set_value name="$skip_service" exact="$skip_service + 1"/>
					</do_elseif>
					<do_elseif value="not $f.isactive and not $is_criminal">
						<set_value name="$skip_idle" exact="$skip_idle + 1"/>
					</do_elseif>
					<do_elseif value="$is_criminal and $kept_criminal">
						<set_value name="$skip_criminal" exact="$skip_criminal + 1"/>
					</do_elseif>
					<do_elseif value="$seen.indexof.{$f.id}">
						<set_value name="$skip_dup" exact="$skip_dup + 1"/>
					</do_elseif>
					<do_else>
						<do_if value="$is_criminal">
							<set_value name="$kept_criminal" exact="1"/>
						</do_if>
						<append_to_list name="$seen" exact="$f.id"/>
						<append_to_list name="md.$cm90.$stui.$owners" exact="table[$id = $f.id, $label = $label]"/>
					</do_else>
				</do_for_each>
				<do_if value="md.$cm90.$stui.$owners.count">
					<sort_list list="md.$cm90.$stui.$owners" sortbyvalue="loop.element.$label"/>
				</do_if>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station owners n=' + md.$cm90.$stui.$owners.count + ' skip_visitor=' + $skip_visitor + ' skip_service=' + $skip_service + ' skip_criminal=' + $skip_criminal + ' skip_idle=' + $skip_idle + ' skip_dup=' + $skip_dup"/>
			</actions>
		</cue>

		<cue name="On_Owner" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="$id" exact="@event.param.$option.$value"/>
				<set_value name="$label" exact="@event.param.$option.$text"/>
				<do_if value="not $id">
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station owner skip empty'"/>
				</do_if>
				<do_else>
					<do_if value="not $label">
						<set_value name="$label" exact="$id"/>
					</do_if>
					<set_value name="md.$cm90.$stui.$ownerid" exact="$id"/>
					<set_value name="md.$cm90.$stui.$ownerlabel" exact="$label"/>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station owner id=' + $id + ' label=' + $label"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
				</do_else>
			</actions>
		</cue>

		<cue name="On_Qty" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="$n" exact="@event.param.$option.$value"/>
				<do_if value="not $n">
					<set_value name="$n" exact="0"/>
				</do_if>
				<set_value name="$row" exact="@event.param.$option.$row"/>
				<do_if value="not $row">
					<set_value name="$row" exact="@event.param.$echo"/>
				</do_if>
				<do_if value="not $row or not @md.$cm90.$strows.{$row}.$macro">
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station qty skip row=' + @$row"/>
				</do_if>
				<do_else>
					<do_if value="$n lt 0">
						<set_value name="$n" exact="0"/>
					</do_if>
					<set_value name="$mid" exact="md.$cm90.$strows.{$row}.$macro"/>
					<set_value name="$obj" exact="md.$cm90.$strows.{$row}.$obj"/>
					<do_if value="not md.$cm90.$stui.$pk_id?">
						<set_value name="md.$cm90.$stui.$pk_id" exact="[]"/>
						<set_value name="md.$cm90.$stui.$pk_n" exact="[]"/>
						<set_value name="md.$cm90.$stui.$pk_obj" exact="[]"/>
					</do_if>
					<set_value name="$slot" exact="md.$cm90.$stui.$pk_id.indexof.{$mid}"/>
					<do_if value="$slot">
						<set_value name="md.$cm90.$stui.$pk_n.{$slot}" exact="$n"/>
						<set_value name="md.$cm90.$stui.$pk_obj.{$slot}" exact="$obj"/>
					</do_if>
					<do_else>
						<append_to_list name="md.$cm90.$stui.$pk_id" exact="$mid"/>
						<append_to_list name="md.$cm90.$stui.$pk_n" exact="$n"/>
						<append_to_list name="md.$cm90.$stui.$pk_obj" exact="$obj"/>
					</do_else>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station qty macro=' + $mid + ' n=' + $n + ' refresh=1'"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
				</do_else>
			</actions>
		</cue>

		<cue name="Set_Status" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="$code" exact="@event.param.$code"/>
				<set_value name="$prev" exact="@md.$cm90.$stui.$status"/>
				<do_if value="$code == 'done'">
					<set_value name="md.$cm90.$stui.$status" exact="{357424,25}"/>
				</do_if>
				<do_elseif value="$code == 'fail'">
					<set_value name="md.$cm90.$stui.$status" exact="{357424,26}"/>
				</do_elseif>
				<set_value name="md.$cm90.$stui.$status_t" exact="player.age"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status code=' + $code + ' prev=' + $prev + ' text=' + @md.$cm90.$stui.$status + ' draw=' + @event.param.$draw + ' later=' + @event.param.$later + ' pane=' + @md.$cm90.$pane + ' t=' + player.age"/>
				<do_if value="@event.param.$draw and @md.$cm90.$pane == 'station'">
					<do_if value="@event.param.$later">
						<set_value name="md.$cm90.$stui.$status_paint" exact="1"/>
						<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status paint scheduled t=' + player.age"/>
						<signal_cue cue="Redraw"/>
					</do_if>
					<do_else>
						<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status refresh now t=' + player.age"/>
						<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
					</do_else>
				</do_if>
				<do_else>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'MID UI station status no repaint draw=' + @event.param.$draw + ' pane=' + @md.$cm90.$pane + ' t=' + player.age"/>
				</do_else>
				<set_value name="md.$cm90.$stbusy" exact="0"/>
				<signal_cue_instantly cue="md.cm90_station_logic.Build_Next"/>
			</actions>
		</cue>

		<cue name="Redraw" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<do_if value="@md.$cm90.$stui.$status_paint and @md.$cm90.$pane == 'station'">
					<set_value name="md.$cm90.$stui.$status_paint" exact="0"/>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status paint t=' + player.age + ' text=' + @md.$cm90.$stui.$status"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
				</do_if>
				<do_else>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'MID UI station status redraw skip paint=' + @md.$cm90.$stui.$status_paint + ' pane=' + @md.$cm90.$pane + ' t=' + player.age"/>
				</do_else>
			</actions>
		</cue>

		<cue name="On_X_Slider" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$xkm" exact="event.param.$value"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station slider x=' + md.$cm90.$stui.$xkm"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="On_Y_Slider" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$ykm" exact="event.param.$value"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station slider y=' + md.$cm90.$stui.$ykm"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="On_Z_Slider" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="md.$cm90.$stui.$zkm" exact="event.param.$value"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station slider z=' + md.$cm90.$stui.$zkm"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
			</actions>
		</cue>

		<cue name="On_Add_Ahead" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Append_Row" param="table[$place = 'ahead']"/>
			</actions>
		</cue>

		<cue name="On_Add_Coords" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Append_Row" param="table[$place = 'abs']"/>
			</actions>
		</cue>

		<cue name="Append_Row" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Ensure_Ui"/>
				<set_value name="$any" exact="0"/>
				<set_value name="$count" exact="0"/>
				<set_value name="$ids" exact="[]"/>
				<set_value name="$ns" exact="[]"/>
				<set_value name="$objs" exact="[]"/>
				<do_all exact="@md.$cm90.$stui.$pk_id.count" counter="$i">
					<append_to_list name="$ids" exact="md.$cm90.$stui.$pk_id.{$i}"/>
					<append_to_list name="$ns" exact="md.$cm90.$stui.$pk_n.{$i}"/>
					<append_to_list name="$objs" exact="md.$cm90.$stui.$pk_obj.{$i}"/>
					<do_if value="md.$cm90.$stui.$pk_n.{$i} gt 0">
						<set_value name="$any" exact="1"/>
						<set_value name="$count" exact="$count + md.$cm90.$stui.$pk_n.{$i}"/>
					</do_if>
				</do_all>
				<do_if value="not md.$cm90.$stui.$race">
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station list add abort: no race'"/>
				</do_if>
				<do_elseif value="not $any">
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station list add abort: empty'"/>
				</do_elseif>
				<do_else>
					<set_value name="$label" exact="md.$cm90.$stui.$race"/>
					<do_all exact="@md.$cm90.$straces.count" counter="$i">
						<do_if value="md.$cm90.$straces.{$i}.$id == md.$cm90.$stui.$race">
							<set_value name="$label" exact="md.$cm90.$straces.{$i}.$label"/>
						</do_if>
					</do_all>
					<set_value name="$place" exact="'ahead'"/>
					<set_value name="$xkm" exact="0"/>
					<set_value name="$ykm" exact="0"/>
					<set_value name="$zkm" exact="0"/>
					<do_if value="@event.param.$place == 'abs'">
						<set_value name="$place" exact="'abs'"/>
						<do_if value="md.$cm90.$stui.$xkm?">
							<set_value name="$xkm" exact="md.$cm90.$stui.$xkm"/>
						</do_if>
						<do_if value="md.$cm90.$stui.$ykm?">
							<set_value name="$ykm" exact="md.$cm90.$stui.$ykm"/>
						</do_if>
						<do_if value="md.$cm90.$stui.$zkm?">
							<set_value name="$zkm" exact="md.$cm90.$stui.$zkm"/>
						</do_if>
					</do_if>
					<do_if value="not md.$cm90_session?">
						<set_value name="md.$cm90_session" exact="table[]"/>
					</do_if>
					<do_if value="not md.$cm90_session.$station?">
						<set_value name="md.$cm90_session.$station" exact="[]"/>
					</do_if>
					<set_value name="$ownerid" exact="''"/>
					<set_value name="$ownerlabel" exact="''"/>
					<do_if value="md.$cm90.$stui.$ownerid?">
						<set_value name="$ownerid" exact="md.$cm90.$stui.$ownerid"/>
					</do_if>
					<do_if value="md.$cm90.$stui.$ownerlabel?">
						<set_value name="$ownerlabel" exact="md.$cm90.$stui.$ownerlabel"/>
					</do_if>
					<do_if value="not $ownerid">
						<set_value name="$ownerid" exact="'player'"/>
						<set_value name="$ownerlabel" exact="@faction.player.knownname"/>
						<do_if value="not $ownerlabel">
							<set_value name="$ownerlabel" exact="'player'"/>
						</do_if>
					</do_if>
					<append_to_list name="md.$cm90_session.$station" exact="table[
							$race = md.$cm90.$stui.$race,
							$label = $label,
							$count = $count,
							$place = $place,
							$xkm = $xkm,
							$ykm = $ykm,
							$zkm = $zkm,
							$ownerid = $ownerid,
							$ownerlabel = $ownerlabel,
							$pk_id = $ids,
							$pk_n = $ns,
							$pk_obj = $objs
						]"/>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station list add place=' + $place + ' race=' + $label + ' count=' + $count + ' owner=' + $ownerid + ' xkm=' + $xkm + ' ykm=' + $ykm + ' zkm=' + $zkm + ' n=' + md.$cm90_session.$station.count"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
				</do_else>
			</actions>
		</cue>

		<cue name="On_Spawn_List" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<do_if value="not @md.$cm90_session.$station.count">
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station list spawn abort: empty'"/>
				</do_if>
				<do_elseif value="@md.$cm90.$stbusy">
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station list spawn abort: busy'"/>
				</do_elseif>
				<do_else>
					<set_value name="md.$cm90.$stqueue" exact="[]"/>
					<do_all exact="md.$cm90_session.$station.count" counter="$i">
						<append_to_list name="md.$cm90.$stqueue" exact="md.$cm90_session.$station.{$i}"/>
					</do_all>
					<remove_value name="md.$cm90_session.$station"/>
					<set_value name="md.$cm90.$stqi" exact="1"/>
					<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH Station list spawn n=' + md.$cm90.$stqueue.count"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
					<signal_cue_instantly cue="md.cm90_station_logic.Build_Next"/>
				</do_else>
			</actions>
		</cue>
	</cues>
</mdscript>
