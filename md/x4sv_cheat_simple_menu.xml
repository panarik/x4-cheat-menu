		<cue name="On_Fit_Kit_Clear" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Fit'" control="'kit_clear'"/>
			</conditions>
			<actions>
				<set_value name="md.$cm90.$kitwares" exact="[]"/>
				<signal_cue_instantly cue="LogFile" param="'HIGH Fit kit_clear'"/>
			</actions>
		</cue>

		<cue name="On_Fit_Kit_Ware" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Fit'" control="'kit_ware'"/>
			</conditions>
			<actions>
				<set_value name="$id" exact="event.param3"/>
				<do_if value="not $id">
					<set_value name="$id" exact="event.param"/>
				</do_if>
				<do_if value="$id">
					<set_value name="$ware" exact="ware.{$id}"/>
					<do_if value="$ware?">
						<append_to_list name="md.$cm90.$kitwares" exact="$ware"/>
						<signal_cue_instantly cue="LogFile" param="'LOW Fit kit_ware id=' + $id + ' ware=' + @$ware.id + ' n=' + md.$cm90.$kitwares.count"/>
					</do_if>
					<do_else>
						<signal_cue_instantly cue="LogFile" param="'HIGH Fit kit_ware miss id=' + $id"/>
					</do_else>
				</do_if>
			</actions>
		</cue>

		<!-- Preset. Sealed: test_3 SUCCESS. Found modules: md/cm90_fit_found.xml, event found_apply. -->
		<cue name="On_Fit_Kit_Ready" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Fit'" control="'kit_ready'"/>
			</conditions>
			<actions>
				<set_value name="$n" exact="event.param3"/>
				<do_if value="not $n">
					<set_value name="$n" exact="event.param"/>
				</do_if>
				<set_value name="$ship" exact="md.$cm90.$lastship"/>
				<signal_cue_instantly cue="LogFile" param="'HIGH Fit kit_ready n=' + $n + ' wares=' + @md.$cm90.$kitwares.count + ' ship=' + $ship + ' mode=' + @md.$cm90.$fitmode + ' loadout=' + @md.$cm90.$loadoutid"/>
				<set_value name="$applied" exact="false"/>
				<do_if value="not $ship?">
					<signal_cue_instantly cue="LogFile" param="'HIGH Fit apply abort: no lastship'"/>
				</do_if>
				<do_else>
					<set_value name="$macro" exact="md.$cm90.$lastmacro"/>
					<do_if value="not $macro">
						<set_value name="$macro" exact="@$ship.macro"/>
					</do_if>
					<do_if value="md.$cm90.$fitmode == 'preset' and md.$cm90.$loadoutid">
						<signal_cue_instantly cue="LogFile" param="'HIGH Fit get_loadout start id=' + md.$cm90.$loadoutid + ' macro=' + @$macro.id"/>
						<get_loadout result="$lo" loadout="md.$cm90.$loadoutid" macro="$macro"/>
						<do_if value="$lo?">
							<apply_loadout object="$ship" loadout="$lo"/>
							<set_value name="$applied" exact="true"/>
							<signal_cue_instantly cue="LogFile" param="'HIGH Fit get_loadout applied id=' + md.$cm90.$loadoutid + ' macro=' + @$macro.id"/>
						</do_if>
						<do_else>
							<signal_cue_instantly cue="LogFile" param="'HIGH Fit get_loadout empty id=' + md.$cm90.$loadoutid + ' fallback=wares'"/>
						</do_else>
					</do_if>
					<do_if value="not $applied and @md.$cm90.$kitwares.count gt 0">
						<signal_cue_instantly cue="LogFile" param="'HIGH Fit generate_loadout start mode=' + @md.$cm90.$fitmode + ' macro=' + @$macro.id + ' wares=' + md.$cm90.$kitwares.count"/>
						<generate_loadout result="$los" macro="$macro" faction="faction.player" wares="md.$cm90.$kitwares" level="1.0" variation="0"/>
						<do_if value="$los.count">
							<apply_loadout object="$ship" loadout="$los.{1}"/>
							<set_value name="$applied" exact="true"/>
							<signal_cue_instantly cue="LogFile" param="'HIGH Fit generate_loadout applied n=' + $los.count + ' wares=' + md.$cm90.$kitwares.count + ' mode=' + @md.$cm90.$fitmode"/>
						</do_if>
						<do_else>
							<signal_cue_instantly cue="LogFile" param="'HIGH Fit generate_loadout empty wares=' + md.$cm90.$kitwares.count + ' mode=' + @md.$cm90.$fitmode"/>
						</do_else>
					</do_if>
					<do_elseif value="not $applied">
						<signal_cue_instantly cue="LogFile" param="'HIGH Fit apply skip: no loadout mode=' + @md.$cm90.$fitmode"/>
					</do_elseif>
				</do_else>
				<do_if value="$ship?">
					<raise_lua_event name="'CheatMenu90.FitVerify'" param="$ship"/>
				</do_if>
			</actions>
		</cue>

		<cue name="Spawn_Empty" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<set_value name="$ware" exact="event.param"/>
				<set_value name="$macro" exact="@$ware.objectmacro"/>
				<do_if value="not $macro">
					<set_value name="$macro" exact="@$ware.component"/>
				</do_if>
				<signal_cue_instantly cue="LogFile" param="'HIGH Spawn start mode=' + @md.$cm90.$fitmode + ' loadout=' + @md.$cm90.$loadoutid + ' ware=' + @$ware.id + ' name=' + @$ware.name + ' macro=' + @$macro.id + ' zone=' + @player.zone + ' ship=' + @player.ship + ' entity=' + @player.entity"/>
				<do_if value="not $macro">
					<signal_cue_instantly cue="LogFile" param="'HIGH Spawn abort: no macro'"/>
				</do_if>
				<do_elseif value="not player.zone?">
					<signal_cue_instantly cue="LogFile" param="'HIGH Spawn abort: no player.zone'"/>
				</do_elseif>
				<do_else>
					<set_value name="$anchor" exact="player.ship"/>
					<do_if value="not $anchor">
						<set_value name="$anchor" exact="player.entity"/>
					</do_if>
					<set_value name="$pos" exact="$anchor.position"/>
					<signal_cue_instantly cue="LogFile" param="'HIGH Spawn pos original-style object=' + @$anchor.id + ' pos=' + $pos + ' zone=' + @player.zone"/>
					<signal_cue_instantly cue="LogFile" param="'HIGH Fit stage1 empty hull ware=' + @$ware.id + ' macro=' + @$macro.id + ' mode=' + @md.$cm90.$fitmode + ' loadout=' + @md.$cm90.$loadoutid"/>
					<set_value name="md.$cm90.$kitwares" exact="[]"/>
					<set_value name="md.$cm90.$lastship" exact="null"/>
					<create_ship name="$ship" macro="$macro" zone="player.zone">
						<owner exact="faction.player" overridenpc="true"/>
						<show_notification text="@$ware.name"/>
						<pilot>
							<select race="[race.argon, race.paranid, race.teladi]" tags="tag.aipilot"/>
						</pilot>
						<people>
							<fillpercent exact="100"/>
							<person role="service" weight="100">
								<select race="[race.argon, race.paranid, race.teladi]" tags="tag.service"/>
							</person>
						</people>
						<safepos object="$anchor" value="$pos"/>
					</create_ship>
					<do_if value="$ship?">
						<set_value name="md.$cm90.$lastship" exact="$ship"/>
						<set_value name="md.$cm90.$lastmacro" exact="$macro"/>
						<set_value name="$Crew" exact="$ship.people.list"/>
						<signal_cue_instantly cue="LogFile" param="'HIGH Spawn crew people=' + @$Crew.count"/>
						<do_all exact="$Crew.count" counter="$j">
							<set_skill object="$ship" template="$Crew.{$j}" type="skilltype.boarding" exact="15"/>
							<set_skill object="$ship" template="$Crew.{$j}" type="skilltype.engineering" exact="15"/>
							<set_skill object="$ship" template="$Crew.{$j}" type="skilltype.management" exact="15"/>
							<set_skill object="$ship" template="$Crew.{$j}" type="skilltype.morale" exact="15"/>
							<set_skill object="$ship" template="$Crew.{$j}" type="skilltype.piloting" exact="15"/>
						</do_all>
						<get_control_entities groupname="$controlCrew" object="$ship"/>
						<signal_cue_instantly cue="LogFile" param="'HIGH Spawn crew control=' + @$controlCrew.count"/>
						<do_all exact="$controlCrew.count" counter="$j">
							<set_skill entity="$controlCrew.{$j}" type="skilltype.boarding" exact="15"/>
							<set_skill entity="$controlCrew.{$j}" type="skilltype.engineering" exact="15"/>
							<set_skill entity="$controlCrew.{$j}" type="skilltype.management" exact="15"/>
							<set_skill entity="$controlCrew.{$j}" type="skilltype.morale" exact="15"/>
							<set_skill entity="$controlCrew.{$j}" type="skilltype.piloting" exact="15"/>
						</do_all>
						<raise_lua_event name="'CheatMenu90.Fit'" param="$ship"/>
					</do_if>
					<signal_cue_instantly cue="LogFile" param="'HIGH Spawn result ship=' + $ship + ' id=' + @$ship.id + ' name=' + @$ship.name + ' exists=' + $ship? + ' resultPos=' + @$ship.position"/>
				</do_else>
			</actions>
		</cue>

		<cue name="On_Log_File" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Log'" control="'file'"/>
			</conditions>
			<actions>
				<set_value name="$path" exact="event.param3"/>
				<do_if value="not $path">
					<set_value name="$path" exact="event.param"/>
				</do_if>
				<signal_cue_instantly cue="LogFile" param="'HIGH Lua wrote ' + $path"/>
			</actions>
		</cue>

		<cue name="Warn_Missing_Api" instantiate="true">
			<conditions>
				<check_any>
					<event_cue_signalled cue="md.Setup.GameStart"/>
					<event_game_loaded/>
				</check_any>
			</conditions>
			<delay exact="5s"/>
			<actions>
				<do_if value="not md.Simple_Menu_API?">
					<signal_cue_instantly cue="LogFile" param="'HIGH UI Warn_Missing_Api: Simple_Menu_API missing'"/>
					<show_notification text="{357423,9006}"/>
				</do_if>
			</actions>
		</cue>
	</cues>
</mdscript>
