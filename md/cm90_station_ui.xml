<?xml version="1.0" encoding="utf-8"?>
<!--
  Spawn Stations paint. Reads md.$cm90.$stui and creates widgets.
  The queue under Build is md.$cm90_session.$station. This file only draws it.
  Clicks go to the UI model. This file does not change state and does not refresh.
-->
<mdscript name="cm90_station_ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
	<cues>
		<cue name="Paint" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="Set_Cols"/>
				<do_if value="md.$cm90.$stui.$paint == 'loading'">
					<signal_cue_instantly cue="Fill_Loading"/>
				</do_if>
				<do_elseif value="md.$cm90.$stui.$paint == 'build'">
					<signal_cue_instantly cue="Fill_Build"/>
				</do_elseif>
				<do_else>
					<signal_cue_instantly cue="Fill_Races"/>
				</do_else>
			</actions>
		</cue>

		<cue name="Set_Cols" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="md.Simple_Menu_API.Call_Table_Method" param="table[
						$method = 'setColWidth',
						$col = 4,
						$width = 80
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Call_Table_Method" param="table[
						$method = 'setColWidthMinPercent',
						$col = 2,
						$width = 16,
						$weight = 1
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Call_Table_Method" param="table[
						$method = 'setColWidthMinPercent',
						$col = 3,
						$width = 16,
						$weight = 3
					]"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station cols type=16w1 name=16w3 qty=80'"/>
			</actions>
		</cue>

		<cue name="Fill_Loading" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $colSpan = 3, $halign = 'left', $wordwrap = true,
						$text = {357424,20}
					]"/>
			</actions>
		</cue>

		<cue name="Fill_Races" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $colSpan = 3, $halign = 'left', $fontsize = 13,
						$text = {357424,6}
					]"/>
				<do_if value="not @md.$cm90.$stui.$racebtns.count">
					<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
							$col = 2, $colSpan = 3, $halign = 'left', $wordwrap = true,
							$text = {357424,21}
						]"/>
				</do_if>
				<do_else>
					<do_all exact="md.$cm90.$stui.$racebtns.count" counter="$i">
						<set_value name="$b" exact="md.$cm90.$stui.$racebtns.{$i}"/>
						<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
						<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
								$col = 2, $colSpan = 3, $echo = $b.$id,
								$onClick = md.cm90_station_ui_model.On_Race,
								$text = table[$text = $b.$text, $halign = 'left']
							]"/>
					</do_all>
				</do_else>
			</actions>
		</cue>

		<cue name="Fill_Build" instantiate="true" namespace="this">
			<conditions>
				<event_cue_signalled/>
			</conditions>
			<actions>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
						$col = 2, $colSpan = 3, $onClick = md.cm90_station_ui_model.On_Back,
						$text = table[$text = {357423,9010}, $halign = 'left']
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $halign = 'left', $fontsize = 13, $text = {357424,17}
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 3, $colSpan = 2, $halign = 'left', $fontsize = 13, $text = {357424,18}
					]"/>
				<do_all exact="@md.$cm90.$stui.$lines.count" counter="$r">
					<set_value name="$line" exact="md.$cm90.$stui.$lines.{$r}"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
					<do_if value="$line.$has_type">
						<do_if value="$line.$t_on">
							<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
									$col = 2, $echo = $line.$t_id,
									$onClick = md.cm90_station_ui_model.On_Type,
									$bgColor = 'Color.table_row_highlight',
									$text = table[$text = $line.$t_text, $halign = 'left']
								]"/>
						</do_if>
						<do_else>
							<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
									$col = 2, $echo = $line.$t_id,
									$onClick = md.cm90_station_ui_model.On_Type,
									$text = table[$text = $line.$t_text, $halign = 'left']
								]"/>
						</do_else>
					</do_if>
					<do_if value="$line.$has_mod">
						<set_value name="$opts" exact="[]"/>
						<append_to_list name="$opts" exact="table[$text = '0', $value = 0, $row = $line.$m_row]"/>
						<append_to_list name="$opts" exact="table[$text = '1', $value = 1, $row = $line.$m_row]"/>
						<append_to_list name="$opts" exact="table[$text = '2', $value = 2, $row = $line.$m_row]"/>
						<append_to_list name="$opts" exact="table[$text = '3', $value = 3, $row = $line.$m_row]"/>
						<append_to_list name="$opts" exact="table[$text = '4', $value = 4, $row = $line.$m_row]"/>
						<append_to_list name="$opts" exact="table[$text = '5', $value = 5, $row = $line.$m_row]"/>
						<append_to_list name="$opts" exact="table[$text = '10', $value = 10, $row = $line.$m_row]"/>
						<append_to_list name="$opts" exact="table[$text = '20', $value = 20, $row = $line.$m_row]"/>
						<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station draw macro=' + $line.$m_macro + ' override=' + $line.$m_qty"/>
						<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
								$col = 3, $halign = 'left', $text = $line.$m_name
							]"/>
						<signal_cue_instantly cue="md.Simple_Menu_API.Make_Dropdown" param="table[
								$col = 4, $echo = $line.$m_row,
								$options = $opts,
								$textOverride = '' + $line.$m_qty,
								$onDropDownConfirmed = md.cm90_station_ui_model.On_Qty
							]"/>
					</do_if>
				</do_all>
				<do_if value="md.$cm90.$stui.$nomods">
					<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
					<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
							$col = 3, $colSpan = 2, $halign = 'left', $wordwrap = true,
							$text = {357424,23}
						]"/>
				</do_if>
				<do_if value="md.$cm90.$stui.$showprev or md.$cm90.$stui.$shownext">
					<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
					<do_if value="md.$cm90.$stui.$showprev">
						<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
								$col = 3, $onClick = md.cm90_station_ui_model.On_Mod_Prev,
								$text = table[$text = {357423,9020}, $halign = 'left']
							]"/>
					</do_if>
					<do_if value="md.$cm90.$stui.$shownext">
						<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
								$col = 4, $onClick = md.cm90_station_ui_model.On_Mod_Next,
								$text = table[$text = {357423,9019}, $halign = 'left']
							]"/>
					</do_if>
				</do_if>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $colSpan = 3, $text = ' '
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $colSpan = 3, $halign = 'left', $fontsize = 13,
						$text = {357424,53}
					]"/>
				<set_value name="$opts" exact="[]"/>
				<do_all exact="@md.$cm90.$stui.$owners.count" counter="$i">
					<set_value name="$own" exact="md.$cm90.$stui.$owners.{$i}"/>
					<append_to_list name="$opts" exact="table[$text = $own.$label, $value = $own.$id]"/>
				</do_all>
				<set_value name="$ownertext" exact="{357424,54}"/>
				<do_if value="@md.$cm90.$stui.$ownerlabel">
					<set_value name="$ownertext" exact="md.$cm90.$stui.$ownerlabel"/>
				</do_if>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Dropdown" param="table[
						$col = 2, $colSpan = 3,
						$options = $opts,
						$textOverride = $ownertext,
						$onDropDownConfirmed = md.cm90_station_ui_model.On_Owner
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $colSpan = 3, $text = ' '
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $halign = 'center', $wordwrap = true,
						$font = 'Helper.standardFontBold', $fontsize = 13,
						$text = {357424,42}
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 3, $colSpan = 2, $halign = 'center', $wordwrap = true,
						$font = 'Helper.standardFontBold', $fontsize = 13,
						$text = {357424,43}
					]"/>
				<set_value name="$xkm" exact="0"/>
				<set_value name="$ykm" exact="0"/>
				<set_value name="$zkm" exact="0"/>
				<do_if value="md.$cm90.$stui.$xkm?">
					<set_value name="$xkm" exact="md.$cm90.$stui.$xkm"/>
				</do_if>
				<do_if value="md.$cm90.$stui.$ykm?">
					<set_value name="$ykm" exact="md.$cm90.$stui.$ykm"/>
				</do_if>
				<do_if value="md.$cm90.$stui.$zkm?">
					<set_value name="$zkm" exact="md.$cm90.$stui.$zkm"/>
				</do_if>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
						$col = 2, $onClick = md.cm90_station_ui_model.On_Add_Ahead,
						$text = table[$text = {357424,52}, $halign = 'center']
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 3, $colSpan = 2, $halign = 'left', $wordwrap = true,
						$text = {357424,47}
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Slider" param="table[
						$col = 3, $colSpan = 2,
						$onSliderCellConfirm = md.cm90_station_ui_model.On_X_Slider,
						$min = -500, $minSelect = -500,
						$max = 500, $maxSelect = 500,
						$fromCenter = true,
						$exceedMaxValue = false,
						$start = $xkm, $step = 1
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 3, $colSpan = 2, $halign = 'left', $wordwrap = true,
						$text = {357424,50}
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Slider" param="table[
						$col = 3, $colSpan = 2,
						$onSliderCellConfirm = md.cm90_station_ui_model.On_Y_Slider,
						$min = -500, $minSelect = -500,
						$max = 500, $maxSelect = 500,
						$fromCenter = true,
						$exceedMaxValue = false,
						$start = $ykm, $step = 1
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 3, $colSpan = 2, $halign = 'left', $wordwrap = true,
						$text = {357424,51}
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Slider" param="table[
						$col = 3, $colSpan = 2,
						$onSliderCellConfirm = md.cm90_station_ui_model.On_Z_Slider,
						$min = -500, $minSelect = -500,
						$max = 500, $maxSelect = 500,
						$fromCenter = true,
						$exceedMaxValue = false,
						$start = $zkm, $step = 1
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
						$col = 3, $colSpan = 2, $onClick = md.cm90_station_ui_model.On_Add_Coords,
						$text = table[$text = {357424,52}, $halign = 'center']
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $colSpan = 3, $text = ' '
					]"/>
				<do_if value="@md.$cm90_session.$station.count gt 0">
					<do_for_each name="$row" in="md.$cm90_session.$station">
						<set_value name="$who" exact="@$row.$ownerlabel"/>
						<do_if value="not $who">
							<set_value name="$who" exact="@$row.$ownerid"/>
						</do_if>
						<do_if value="not $who">
							<set_value name="$who" exact="'player'"/>
						</do_if>
						<set_value name="$line" exact="$row.$label + '  ' + $row.$count + '  ' + $who + '  ahead'"/>
						<do_if value="$row.$place == 'abs'">
							<set_value name="$line" exact="$row.$label + '  ' + $row.$count + '  ' + $who + '  X ' + $row.$xkm + ' Y ' + $row.$ykm + ' Z ' + $row.$zkm"/>
						</do_if>
						<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
						<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
								$col = 2, $colSpan = 3, $halign = 'left', $wordwrap = true,
								$text = $line
							]"/>
					</do_for_each>
				</do_if>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
						$col = 2, $colSpan = 3, $onClick = md.cm90_station_ui_model.On_Spawn_List,
						$text = table[$text = {357424,49}, $halign = 'center']
					]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
				<signal_cue_instantly cue="md.cm90_window.LogFile" param="'HIGH UI station status draw t=' + player.age + ' paint=' + @md.$cm90.$stui.$status_paint + ' text=' + @md.$cm90.$stui.$status"/>
				<signal_cue_instantly cue="md.Simple_Menu_API.Make_Text" param="table[
						$col = 2, $colSpan = 3, $halign = 'left', $wordwrap = true,
						$text = md.$cm90.$stui.$status
					]"/>
			</actions>
		</cue>
	</cues>
</mdscript>
