<?xml version="1.0" encoding="utf-8"?>
<!--
  Found modules. The preset path does not enter this file.
  Basket: md.$cm90.$foundwares. Queue: md.$cm90.$foundqueue.
  Install is generate_loadout of this basket, then apply_loadout.
  SaveLoadout id cm90_auto does not equip a live hull (Centurion, 2026-10-03).
-->
<mdscript name="cm90_fit_found" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
	<cues>
		<cue name="On_Found_Clear" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Fit'" control="'found_clear'"/>
			</conditions>
			<actions>
				<set_value name="md.$cm90.$foundwares" exact="[]"/>
				<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit found_clear'"/>
			</actions>
		</cue>

		<cue name="On_Found_Ware" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Fit'" control="'found_ware'"/>
			</conditions>
			<actions>
				<set_value name="$id" exact="event.param3"/>
				<do_if value="not $id">
					<set_value name="$id" exact="event.param"/>
				</do_if>
				<do_if value="$id">
					<set_value name="$ware" exact="ware.{$id}"/>
					<do_if value="$ware?">
						<append_to_list name="md.$cm90.$foundwares" exact="$ware"/>
						<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'LOW Fit found_ware id=' + $id + ' ware=' + @$ware.id + ' n=' + md.$cm90.$foundwares.count"/>
					</do_if>
					<do_else>
						<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit found_ware miss id=' + $id"/>
					</do_else>
				</do_if>
			</actions>
		</cue>

		<cue name="On_Fit_Found_Ready" instantiate="true" namespace="this">
			<conditions>
				<event_ui_triggered screen="'CM90Fit'" control="'found_apply'"/>
			</conditions>
			<actions>
				<set_value name="$n" exact="event.param3"/>
				<do_if value="not $n">
					<set_value name="$n" exact="event.param"/>
				</do_if>
				<do_if value="@md.$cm90.$fitmode == 'preset'">
					<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit found cue ignored mode=preset'"/>
				</do_if>
				<do_else>
					<set_value name="$ship" exact="null"/>
					<set_value name="$macro" exact="null"/>
					<do_if value="@md.$cm90.$foundqueue.count gt 0">
						<set_value name="$row" exact="md.$cm90.$foundqueue.{1}"/>
						<set_value name="$ship" exact="$row.$ship"/>
						<set_value name="$macro" exact="$row.$macro"/>
						<remove_from_list name="md.$cm90.$foundqueue" exact="$row"/>
						<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit queue ship=' + $ship + ' left=' + @md.$cm90.$foundqueue.count + ' queue=found'"/>
					</do_if>
					<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit found_apply n=' + $n + ' wares=' + @md.$cm90.$foundwares.count + ' ship=' + $ship + ' mode=' + @md.$cm90.$fitmode"/>
					<do_if value="not @$ship.exists">
						<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit queue miss queue=found reason=empty'"/>
					</do_if>
					<do_else>
						<do_if value="not $macro">
							<set_value name="$macro" exact="@$ship.macro"/>
						</do_if>
						<do_if value="@md.$cm90.$foundwares.count gt 0">
							<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit generate_loadout start mode=found-modules macro=' + @$macro.id + ' wares=' + md.$cm90.$foundwares.count"/>
							<generate_loadout result="$los" macro="$macro" faction="faction.player" wares="md.$cm90.$foundwares" level="1.0" variation="0"/>
							<do_if value="$los.count">
								<apply_loadout object="$ship" loadout="$los.{1}"/>
								<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit generate_loadout applied n=' + $los.count + ' wares=' + md.$cm90.$foundwares.count + ' mode=found-modules ship=' + $ship"/>
							</do_if>
							<do_else>
								<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit generate_loadout empty wares=' + md.$cm90.$foundwares.count + ' mode=found-modules'"/>
							</do_else>
						</do_if>
						<do_else>
							<signal_cue_instantly cue="md.x4sv_cheat_simple_menu.LogFile" param="'HIGH Fit apply skip: no loadout mode=found-modules'"/>
						</do_else>
						<raise_lua_event name="'CheatMenu90.FitVerify'" param="$ship"/>
					</do_else>
				</do_else>
			</actions>
		</cue>
	</cues>
</mdscript>
